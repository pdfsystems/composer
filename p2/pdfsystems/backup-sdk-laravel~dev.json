                    "spatie/laravel-package-tools": "^1.16"
                },
                "require-dev": {
                    "laravel/pint": "^1.14",
                    "nunomaduro/collision": "^8.1.1||^7.10.0",
                    "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0||^8.22.0",
                    "pestphp/pest": "^4.0||^3.0",
                    "pestphp/pest-plugin-arch": "^4.0||^3.0",
                    "pestphp/pest-plugin-laravel": "^4.0||^3.0"
                },
                "time": "2026-03-27T15:32:20+00:00",
                "default-branch": true,
                "type": "library",
                "extra": {
                    "laravel": {
                        "providers": [
                            "Pdfsystems\\Backup\\BackupServiceProvider"
                        ]
                    }
                },
                "autoload": {
                    "psr-4": {
                        "Pdfsystems\\Backup\\": "src/"
